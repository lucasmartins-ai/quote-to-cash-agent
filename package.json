{
  "name": "quote-to-cash-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A chat agent that turns a customer conversation into a PayPal invoice, with the owner approving every price.",
  "license": "MIT",
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "test": "node --import tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.9"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@paypal/agent-toolkit": "^1.11.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
